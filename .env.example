# Copie este archivo a .env y complete la contraseña. El .env no se sube al repositorio.

# Opción 1 (por defecto): Aurora PostgreSQL de Bluecore.
# sslmode=require cifra la conexión con AWS.
DATABASE_URL=postgresql+psycopg://usuario_a:<contraseña>@<host-aurora>:5432/demo?sslmode=require

# Opción 2: PostgreSQL local en Docker. Para usarla, comente la línea anterior,
# descomente esta y ejecute: docker compose --profile local-db up --build
# (desde los contenedores el host de la base es "db"; no usar localhost)
# DATABASE_URL=postgresql+psycopg://usuario_a:usuario_a@db:5432/demo

# Esquema asignado a usuario_a; la app fija search_path en este esquema
DB_SCHEMA=esquema_a
