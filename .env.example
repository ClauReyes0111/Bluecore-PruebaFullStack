# Copie este archivo a .env (cp .env.example .env). El .env está en .gitignore y no se sube.
# Tal como está, funciona sin modificaciones con la base local en Docker.

# --- Opción ACTIVA: PostgreSQL local en Docker (pruebas locales) ---
# COMPOSE_PROFILES hace que "docker compose up" también levante el contenedor db
COMPOSE_PROFILES=local-db
DATABASE_URL=postgresql+psycopg://usuario_a:usuario_a@db:5432/demo

# --- Opción manual: Aurora PostgreSQL de Bluecore (pruebas reales) ---
# La contraseña no está en el repositorio: escríbala usted en su .env local.
# Para usarla, comente las dos líneas locales de arriba (COMPOSE_PROFILES y DATABASE_URL)
# y descomente la siguiente. sslmode=require cifra la conexión con AWS.
# DATABASE_URL=postgresql+psycopg://usuario_a:<contraseña>@<host-aurora>:5432/demo?sslmode=require

# Esquema asignado a usuario_a; la app fija search_path en este esquema
DB_SCHEMA=esquema_a
