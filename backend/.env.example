# Para ejecutar el backend SIN Docker. Copie este archivo a .env (está en .gitignore).
# Obligatorio: la app no arranca sin DATABASE_URL.

# --- Opción ACTIVA: PostgreSQL local en Docker (requiere: docker compose up -d db) ---
DATABASE_URL=postgresql+psycopg://usuario_a:usuario_a@localhost:5432/demo

# --- Opción manual: Aurora PostgreSQL de Bluecore ---
# La contraseña no está en el repositorio: escríbala usted en su .env local.
# Para usarla, comente la línea local de arriba y descomente esta.
# DATABASE_URL=postgresql+psycopg://usuario_a:<contraseña>@<host-aurora>:5432/demo?sslmode=require

# Esquema asignado a usuario_a; la app fija search_path en este esquema
DB_SCHEMA=esquema_a
# Orígenes permitidos por CORS (formato JSON)
CORS_ORIGINS=["http://localhost:4200"]
